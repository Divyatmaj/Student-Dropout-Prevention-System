# Copy to server/.env for local development. Never commit the real file.

# Runtime connection used by the API. On Neon, use the POOLED connection
# string (host contains "-pooler") and keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/udaan?sslmode=require"

# Used by Prisma Migrate. On Neon, use the DIRECT (non-pooled) connection
# string. Leave empty to reuse DATABASE_URL (fine for a local Postgres).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/udaan?sslmode=require"

# Local API port. The web app's dev server proxies /api to it.
PORT=5000

# Only needed if the web app is served from a different origin than the API
# (comma-separated). Leave empty when both share one domain, as on Vercel.
CORS_ORIGINS=

# Max connections in each API instance's pool. Keep small on serverless.
DB_POOL_MAX=5
