# Optional local overrides for the Udaan API. Copy to server/.env if needed.
#
# With Neon, you usually don't need this file: `neon deploy` / `neon env pull`
# writes DATABASE_URL and DATABASE_URL_UNPOOLED into the repo's .env.local,
# which the API and the Prisma CLI read automatically.

# Pooled connection used by the API (Neon host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used only by Prisma Migrate.
# Leave unset for a local Postgres to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local API port. The web app's dev server proxies /api to it.
PORT=5000

# Only needed if the web app is served from a different origin than the API
# (comma-separated). Leave empty when both share one domain, as on Vercel.
CORS_ORIGINS=

# Max connections in each API instance's pool. Keep small on serverless.
DB_POOL_MAX=5
