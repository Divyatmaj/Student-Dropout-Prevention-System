# Copy to client/.env.local and adjust as needed.

# Base path for API calls. Keep it relative so the same build works locally
# (via the Vite proxy) and on Vercel (same-origin serverless function).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api/* during local development.
VITE_DEV_API_PROXY=http://localhost:5000

# false (default) = call the Udaan API
# true            = use local mock data only (frontend work without the API)
VITE_USE_MOCKS=false

# true = list the demo accounts (password included) on the login page.
# Anyone who can open the site could then sign in as the demo admin, so only
# turn this on for a demo database you don't mind being changed.
VITE_SHOW_DEMO_ACCOUNTS=false
